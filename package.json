{
  "name": "typora-canvas",
  "version": "0.1.0",
  "private": true,
  "description": "A Canvas-based rendering plugin for Typora, built for large Markdown documents.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser.mjs",
    "install:typora": "node scripts/install.mjs",
    "uninstall:typora": "node scripts/install.mjs --uninstall"
  },
  "dependencies": {
    "markdown-it": "14.3.3",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.56.1"
  }
}
